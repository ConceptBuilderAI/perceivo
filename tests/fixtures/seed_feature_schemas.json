        "rsi_14": {
          "name": "rsi_14",
          "dtype": "float64",
          "description": "RSI(14) normalized to 0-1 range",
          "nullable": false,
          "default": null
        },
        "macd_norm": {
          "name": "macd_norm",
          "dtype": "float64",
          "description": "MACD line normalized by 1% of close",
          "nullable": false,
          "default": null
        },
        "macd_signal_norm": {
          "name": "macd_signal_norm",
          "dtype": "float64",
          "description": "MACD signal line normalized",
          "nullable": false,
          "default": null
        },
        "macd_hist_norm": {
          "name": "macd_hist_norm",
          "dtype": "float64",
          "description": "MACD histogram normalized",
          "nullable": false,
          "default": null
        },
        "bb_upper_ratio": {
          "name": "bb_upper_ratio",
          "dtype": "float64",
          "description": "Bollinger upper band / close ratio",
          "nullable": false,
          "default": null
        },
        "bb_lower_ratio": {
          "name": "bb_lower_ratio",
          "dtype": "float64",
          "description": "Bollinger lower band / close ratio",
          "nullable": false,
          "default": null
        },
        "volume_norm": {
          "name": "volume_norm",
          "dtype": "float64",
          "description": "Volume normalized by rolling max",
          "nullable": false,
          "default": null
        },
        "high_low_range": {
          "name": "high_low_range",
          "dtype": "float64",
          "description": "(High - Low) / Close",
          "nullable": false,
          "default": null
