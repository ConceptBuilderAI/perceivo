        "sma_50_ratio": {
          "name": "sma_50_ratio",
          "dtype": "float64",
          "description": "SMA(50) / close price ratio",
          "nullable": false,
          "default": null
        },
        "ema_12_ratio": {
          "name": "ema_12_ratio",
          "dtype": "float64",
