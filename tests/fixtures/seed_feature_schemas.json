        "open": {
          "name": "open",
          "dtype": "float64",
          "description": "Opening price for the 5-min candle",
          "nullable": false,
          "default": null
        },
        "high": {
          "name": "high",
          "dtype": "float64",
          "description": "High price for the 5-min candle",
          "nullable": false,
          "default": null
        },
        "low": {
          "name": "low",
          "dtype": "float64",
          "description": "Low price for the 5-min candle",
          "nullable": false,
          "default": null
        },
        "close": {
          "name": "close",
          "dtype": "float64",
          "description": "Closing price for the 5-min candle",
          "nullable": false,
          "default": null
        },
        "volume": {
          "name": "volume",
