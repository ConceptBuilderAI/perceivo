{
  "_source": "the platform's seed feature definitions, get_schema() executed against the SDK and dumped with model_dump(mode='json')",
  "schemas": {
    "image_classifier": {
      "properties": {
        "image_id": {
          "name": "image_id",
          "dtype": "string",
          "description": "Image identifier (e.g., cat_00123, dog_00456)",
          "nullable": false,
          "default": null
        },
        "feature_vector": {
          "name": "feature_vector",
          "dtype": "list[float64]",
          "description": "512-dim ResNet18 feature embedding",
          "nullable": false,
          "default": null
        },
        "label": {
          "name": "label",
          "dtype": "int64",
          "description": "Class label (0=cat, 1=dog)",
          "nullable": false,
          "default": null
        },
        "label_name": {
          "name": "label_name",
          "dtype": "string",
          "description": "Human-readable class name",
          "nullable": true,
          "default": null
        },
        "event_timestamp": {
          "name": "event_timestamp",
          "dtype": "timestamp",
          "description": "When the image was processed",
          "nullable": false,
          "default": null
        }
      },
      "entity_key": [
        "image_id"
      ],
      "timestamp_field": "event_timestamp",
      "version": "1.0",
      "description": "Image Classifier feature schema for dog/cat classification"
    },
    "recommender": {
      "properties": {
        "user_id": {
          "name": "user_id",
          "dtype": "string",
          "description": "User identifier",
          "nullable": false,
          "default": null
        },
        "item_id": {
          "name": "item_id",
          "dtype": "string",
          "description": "Item identifier",
          "nullable": false,
          "default": null
        },
        "event_timestamp": {
          "name": "event_timestamp",
          "dtype": "timestamp",
          "description": "When the interaction occurred",
          "nullable": false,
          "default": null
        },
        "label": {
          "name": "label",
          "dtype": "int64",
          "description": "Interaction label (1=positive, 0=negative)",
          "nullable": false,
          "default": 1
        },
        "age": {
          "name": "age",
          "dtype": "int64",
          "description": "User age",
          "nullable": true,
          "default": null
        },
        "gender": {
          "name": "gender",
          "dtype": "string",
          "description": "User gender (M/F/O)",
          "nullable": true,
          "default": null
        },
        "activity_level": {
          "name": "activity_level",
          "dtype": "string",
          "description": "Activity level (low/medium/high)",
          "nullable": true,
          "default": null
        },
        "category": {
          "name": "category",
          "dtype": "string",
          "description": "Item category",
          "nullable": true,
          "default": null
        },
        "price": {
          "name": "price",
          "dtype": "float64",
          "description": "Item price",
          "nullable": true,
          "default": null
        },
        "avg_rating": {
          "name": "avg_rating",
          "dtype": "float64",
          "description": "Average rating (1-5)",
          "nullable": true,
          "default": null
        }
      },
      "entity_key": [
        "user_id",
        "item_id"
      ],
      "timestamp_field": "event_timestamp",
      "version": "1.0",
      "description": "NCF Recommender feature schema for user-item interactions"
    },
    "stock_predictor": {
      "properties": {
        "symbol": {
          "name": "symbol",
          "dtype": "string",
          "description": "Stock ticker symbol (e.g., AAPL, MSFT)",
          "nullable": false,
          "default": null
        },
        "interval_time": {
          "name": "interval_time",
          "dtype": "string",
          "description": "5-minute interval timestamp (YYYY-MM-DD HH:MM:SS)",
          "nullable": false,
          "default": null
