        "open_close_range": {
          "name": "open_close_range",
          "dtype": "float64",
          "description": "(Open - Close) / Close",
          "nullable": false,
          "default": null
        },
        "event_timestamp": {
          "name": "event_timestamp",
          "dtype": "timestamp",
          "description": "When the record was processed",
          "nullable": false,
          "default": null
        }
      },
      "entity_key": [
        "symbol",
        "interval_time"
      ],
      "timestamp_field": "event_timestamp",
      "version": "1.0",
      "description": "Stock Predictor feature schema - 5min intraday OHLCV with technical indicators"
    }
  }
}
